{
  "name": "gongzhuo-novel-studio",
  "version": "0.2.0",
  "private": true,
  "description": "共著 · 本地多 AI 小说工作台",
  "author": "Gongzhuo Studio",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "package": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "verify:capacity": "node scripts/verify-capacity.mjs",
    "format": "prettier --write src electron tests scripts *.json *.ts *.md docs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.5.0",
    "iconv-lite": "^0.7.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.gongzhuo.studio",
    "productName": "共著",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Gongzhuo-Setup-${version}.${ext}"
  }
}
